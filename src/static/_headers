# Cache rules for hosts that read a _headers file (Netlify, Cloudflare Pages).
# GitHub Pages ignores this file and sends its own Cache-Control (about 10 minutes).
# Photo, font, image, CSS, and JS URLs are stable paths plus ?v=<content hash>.
# The hash changes when the bytes change, so a year-long immutable cache is safe.
# HTML stays short so copy and venue facts can update without a hard refresh.

/assets/photos/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/art/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=600

/
  Cache-Control: public, max-age=600
